rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'restubumi1000@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function myId() {
      return request.auth.token.email == 'restubumi1000@gmail.com' ? 'restu' :
             request.auth.token.email == 'susiyulianti130697@gmail.com' ? 'susi' :
             request.auth.token.email.split('@')[0];
    }

    match /messages/{id} {
      allow read, create: if signedIn();
    }

    // Setiap user otomatis membuat/memperbarui profilnya saat login.
    // Admin dapat membaca semua profil untuk dropdown pilihan user.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == 'user';
      allow update: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == uid
         && request.resource.data.uid == resource.data.uid
         && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    match /kpi/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == myId());
      allow create, update, delete: if isAdmin();
    }

    match /kaizen/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == myId());
      allow create, update, delete: if isAdmin();
    }
  }
}

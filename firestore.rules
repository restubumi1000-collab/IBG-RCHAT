rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'restubumi1000@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /messages/{messageId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if isAdmin();
    }

    // Data bulanan lama v8.5 tetap dapat dibaca untuk menjaga total lama.
    match /kpi/{kpiId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /kaizen/{kaizenId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // v8.6: riwayat KPI individual.
    // User biasa hanya boleh membaca record dengan ownerUid miliknya sendiri.
    match /kpi_history/{historyId} {
      allow read: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
